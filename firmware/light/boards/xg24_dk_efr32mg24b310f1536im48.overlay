/*
 * Light node pin mapping for the Silicon Labs xG24 DK (EFR32MG24 / MGM240 core).
 */
/ {
	aliases {
		light-relay = &light_relay;
	};

	light_relays {
		compatible = "gpio-leds";
		light_relay: relay_0 {
			/* Example: PC number pin on an expansion header. Adjust
			 * to the real relay driver pin on your board. */
			gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
			label = "Light relay";
		};
	};
};
