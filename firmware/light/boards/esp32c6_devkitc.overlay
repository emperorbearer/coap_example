/*
 * Light node (tunable-white LED PCB) on ESP32-C6. Cool/warm white LEDs driven
 * by the LEDC PWM peripheral for color temperature + dimming.
 *
 * NOTE: LEDC channel/pin wiring is board-specific — confirm the GPIOs/pinmux
 * against your custom PCB. See docs/hardware/light-node.md.
 */
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
	aliases {
		pwm-cw = &led_cw;
		pwm-ww = &led_ww;
	};

	pwmleds {
		compatible = "pwm-leds";
		led_cw: led_cw { pwms = <&ledc0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>; };
		led_ww: led_ww { pwms = <&ledc0 1 PWM_HZ(1000) PWM_POLARITY_NORMAL>; };
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 { reg = <0x0>; timer = <0>; };
	channel1@1 { reg = <0x1>; timer = <0>; };
};

&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH0_GPIO0>,
				 <LEDC_CH1_GPIO1>;
			output-enable;
		};
	};
};
