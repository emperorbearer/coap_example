/*
 * Light node = tunable-white LED PCB (cool white + warm white, nRF54L15),
 * powered from a KC-certified SMPS DC rail. Two PWM channels drive the CW and
 * WW LED strings for color temperature + dimming.
 *
 * This overlay targets the nRF54L15 DK for prototyping; on the custom PCB keep
 * the same aliases (pwm-cw / pwm-ww) and map them to the real LED-driver gate
 * pins. Pins/channels below are examples — confirm against your schematic.
 * See docs/hardware/light-node.md.
 */
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		pwm-cw = &led_cw;
		pwm-ww = &led_ww;
	};

	pwmleds {
		compatible = "pwm-leds";
		led_cw: led_cw { pwms = <&pwm20 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
		led_ww: led_ww { pwms = <&pwm20 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
	};
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&pwm20_default>;
	pinctrl-names = "default";
};

&pinctrl {
	pwm20_default: pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 4)>,
				<NRF_PSEL(PWM_OUT1, 1, 5)>;
		};
	};
};
