/*
 * EXAMPLE overlay to fit an nPM1300 PMIC (battery charger + fuel gauge) to the
 * panel switch. Named *.overlay.example so it is NOT applied automatically.
 *
 * To use: merge into your board overlay, enable the nPM1300 Kconfig options in
 * prj.conf, and link your Li-ion cell's nRF Fuel Gauge battery model.
 *
 * IMPORTANT: the I2C instance/pins, charger limits (term voltage, charge
 * current, thermistor), regulator rails, and cell parameters are HARDWARE
 * specific. Copy known-good values from the nPM1300 datasheet / your schematic
 * and the NCS `npm1300_fuel_gauge` sample. Values below are a starting template.
 *
 * Target here: nRF54L15, I2C22. Adjust to your wiring.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_pmic>;
	pinctrl-names = "default";

	npm1300: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4200000>;       /* cell full voltage */
			term-warm-microvolt = <4000000>;
			current-microamp = <150000>;      /* charge current */
			term-current-percent = <10>;
			vbus-limit-microamp = <500000>;   /* USB-C input limit */
			thermistor-ohms = <10000>;        /* NTC on the cell */
			thermistor-beta = <3380>;
			charging-enable;
		};

		npm1300_buck1: BUCK1 {
			compatible = "nordic,npm1300-regulator";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;             /* nRF54L15 main rail */
		};

		npm1300_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};
	};
};

&pinctrl {
	i2c22_pmic: i2c22_pmic {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 21)>,
				<NRF_PSEL(TWIM_SDA, 1, 22)>;
		};
	};
};
