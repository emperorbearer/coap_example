/*
 * Panel switch inputs for the nRF54L15 DK (prototype for the switch-cover PCB).
 *
 * - Four action buttons + the encoder push, exposed as input key codes.
 * - A rotary encoder via gpio-qdec, reporting relative INPUT_REL_WHEEL events.
 *
 * Pins are examples for prototyping on the DK; on the real battery PCB pick
 * SENSE-capable pins so any input can wake the SoC from deep sleep, and use
 * high-value pull-ups to limit leakage. See docs/hardware/panel-switch.md.
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	panel_buttons {
		compatible = "gpio-keys";
		btn0: btn0 {
			gpios = <&gpio1 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
			label = "Toggle";
		};
		btn1: btn1 {
			gpios = <&gpio1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
			label = "Encoder mode";
		};
		btn2: btn2 {
			gpios = <&gpio1 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_2>;
			label = "Color preset";
		};
		btn3: btn3 {
			gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_3>;
			label = "All off";
		};
		btn_enc: btn_enc {
			gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
			label = "Encoder push";
		};
	};

	panel_encoder: panel_encoder {
		compatible = "gpio-qdec";
		gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			<&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
	};
};
